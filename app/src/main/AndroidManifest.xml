<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed for the online database (Supabase) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Coach messages (Android 13+ also asks the user at runtime) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Workout keeps running with the screen off (foreground service, type "health").
         Android 14+ also needs one of ACTIVITY_RECOGNITION / BODY_SENSORS / HIGH_SAMPLING_RATE_SENSORS
         for a health service; HIGH_SAMPLING_RATE_SENSORS is a normal permission (no pop-up). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Polar">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Polar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.page.SignPage"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.page.ConsentPage"
            android:exported="false" />
        <activity
            android:name=".ui.page.MainPage"
            android:exported="false" />
        <activity
            android:name=".ui.page.WorkoutDetailPage"
            android:exported="false" />
        <activity
            android:name=".ui.page.AssessmentPage"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.page.EcgPage"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.page.WorkoutPage"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.page.SettingsPage"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.page.BaselinePage"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.page.H10GuidePage"
            android:exported="false"
            android:screenOrientation="portrait" />
        <service
            android:name=".service.WorkoutService"
            android:exported="false"
            android:foregroundServiceType="health" />
    </application>

</manifest>